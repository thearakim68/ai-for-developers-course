# Copy this file to .env, then fill in only the keys you use.
# .env is ignored by git, so your keys stay on your computer.
# Never paste a key into code, a chat, or a screenshot.

# Which AI the labs use: fake (free, offline), anthropic, openai, gemini, ollama
COURSE_LLM_PROVIDER=fake

# Cost guard: the labs stop when your course total passes this many US dollars
COURSE_SPEND_CAP_USD=5

# API keys (leave empty if you don't use that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models (only needed for that provider)
COURSE_OPENAI_MODEL=
COURSE_GEMINI_MODEL=
COURSE_OLLAMA_MODEL=
